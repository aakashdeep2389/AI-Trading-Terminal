APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MARKET_PROVIDER=twelvedata
MARKET_API_KEY=
# TWELVEDATA_API_KEY is also accepted as an alias for MARKET_API_KEY.
DATABASE_URL=postgresql+asyncpg://trading:trading_dev@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
MARKET_STALE_AFTER_SECONDS=20
# Poll interval for the live candle stream. Twelve Data plan limits apply.
MARKET_STREAM_INTERVAL_SECONDS=15
AI_PROVIDER=disabled
NEWS_PROVIDER=disabled
NEWS_API_KEY=
AI_BASE_URL=
AI_AUTH_TOKEN=
AI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=False
